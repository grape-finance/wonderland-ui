# WalletConnect Cloud project ID (required for WalletConnect in browsers without an injected wallet)
VITE_WALLETCONNECT_PROJECT_ID=

# Written by sync-frontend:mainnet. Enables the test-token faucet only for a
# deployment whose accepted reserve contracts are permissionless mocks.
VITE_USE_MOCK_TOKENS=false

# Fresh mainnet deployment addresses.
VITE_DAO_ADDRESS=
VITE_PULSAR_ADDRESS=
VITE_QUASAR_ADDRESS=
VITE_WRAPPED_QUASAR_ADDRESS=
VITE_USDC_ADDRESS=
VITE_WPLS_ADDRESS=
VITE_PDAI_ADDRESS=
VITE_STAKING_ADDRESS=
VITE_STAKING_HELPER_ADDRESS=
VITE_DISTRIBUTOR_ADDRESS=
VITE_BONDING_CALC_ADDRESS=
VITE_TREASURY_ADDRESS=
VITE_USDC_BOND_ADDRESS=
VITE_WPLS_BOND_ADDRESS=
VITE_PULSAR_PDAI_LP_ADDRESS=

# pDAI bond depository deployed by PULSAR. The PulseChain pDAI token itself is
# 0x6B175474E89094C44Da98b954EedeAC495271d0F and has 18 decimals.
VITE_PDAI_BOND_ADDRESS=

# Live price source and real-token price references. The sync script writes
# these automatically, including when the accepted principals are mocks.
VITE_AAVE_ORACLE_ADDRESS=0x0f907F1D586302AD04283f5739bA20f28fD7cBC6
VITE_USDC_PRICE_ASSET_ADDRESS=0x15D38573d2feeb82e7ad5187aB8c1D52810B1f07
VITE_WPLS_PRICE_ASSET_ADDRESS=0xA1077a294dDE1B09bB078844df40758a5D0f9a27
VITE_PDAI_PRICE_ASSET_ADDRESS=0x6B175474E89094C44Da98b954EedeAC495271d0F
